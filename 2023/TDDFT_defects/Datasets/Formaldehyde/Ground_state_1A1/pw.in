&control
    calculation = 'relax',
    prefix='pwscf',
    pseudo_dir='/home/jinyuchem/program/QE/pseudo-potential',
    outdir = './',
    verbosity='high',
    tprnfor=.TRUE.,
    tstress=.TRUE.,
    forc_conv_thr=0.000039
    wf_collect=.true.
/
&system
    ibrav=0,
    nat=4,
    ntyp= 3,
    ecutwfc = 90,
    nbnd = 10
/
&electrons
    diago_full_acc=.true.,
    conv_thr=1.0D-8
/
&ions
    ion_dynamics='bfgs'
 /
 &cell
