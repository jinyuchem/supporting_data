&CONTROL
calculation = 'scf'
verbosity = 'high'
tprnfor=.TRUE.
tstress=.TRUE.
wf_collect = .true.
prefix='pwscf'
outdir = './'
pseudo_dir='/home/jinyuchem/program/QE/pseudo-potential'
/
&SYSTEM
ibrav = 0
ecutwfc = 60
tot_charge = -1
nspin = 2
tot_magnetization = 2.0
nbnd = 150
nat = 63
ntyp = 2
input_dft = 'pbe0'
