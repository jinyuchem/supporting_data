input_west:
  qe_prefix: pwscf
  west_prefix: pwscf
  outdir: ./

wbse_init_control:
  wbse_init_calculation: S
  solver: TDDFT

wbse_control:
  wbse_calculation: D
  scissor_ope: 0.0
  n_liouville_eigen: 2
  n_liouville_times: 10
  n_liouville_maxiter: 1000
  n_liouville_read_from_file: 0
  trev_liouville: 0.0000000001
  trev_liouville_rel: 0.00000001
  wbse_epsinfty: 1.0
  spin_excitation: S
  l_preconditioning: True
  l_pre_shift: False
  l_forces: True
  forces_state: 1
  l_reduce_io: True
