&INPUT_WEST
    outdir                   = './'
    which_bse_method         = 'FF'
/
&WBSE_INIT
    wbse_init_calculation   = 'S'
    which_spin_channel      =  0
    chi_kernel              = 'CHI'
    l_use_localise_repr     = .false.
    l_use_bisection_thr     = .false.
    qbox_bisec_wfc_filename = 'qb.gs.xml'
/
&QBOX_CONTROL
    xml_file = 'qb.gs.xml'
    xc = 'PBE'
    amplitude = 0.0
    wf_dyn = 'PSDA'
    nitscf = 20
    nite = 0
    io = 'base64_parallel'
/  
&WBSE_CONTROL
    !
    wbse_calculation         = 'S'
    l_qp_correction          = .false.
    wbse_diag_method         = 'david'
    !
    l_diag_term_only         = .false.
    l_bse_calculation        = .false.
    !
    l_hybrid_calculation     = .true.
    l_exx_fraction           = 0.18
    l_h_loc                  = .false.
    l_h_bis                  = .false.
    l_h_ovlp_thr             = 0.0
    l_h_qbox_bis_wfc_fname   = 'qb.gs.xml'
    !
    l_subspace               = .true.
    !
    n_trunc_bands            = 0
    !
    n_plep_eigen             =  10
    n_plep_times             =  4
    n_plep_maxiter           =  10000
    n_plep_read_from_file    =  0
    l_preconditioning        = .true.
    trev_plep                =  1.D-6
    trev_plep_rel            =  1.D
    !
    force_n_trunc_bands      = 0
    !
    l_tddft_force            = .false.
    force_state              = 8
    wbse_zv_scf_tr2          = 1.D-7
    snd_coeff                = 0.05
    !
    wbse_acc_eig             = .true.
    wbse_acc_force           = .true.
    wbse_acc                 = 3
    wbse_acc_dav_thr         = 1D-16
    wbse_acc_cg_thr          = 1D-16
    !
!    poor_of_ram              = .true.
!    poor_of_ram_drho2        = .true.
/
