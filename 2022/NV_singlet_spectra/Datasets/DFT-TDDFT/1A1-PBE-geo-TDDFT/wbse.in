&INPUT_WEST
    outdir                   = './'
    which_bse_method         = 'FF'
/
&WBSE_INIT
    wbse_init_calculation   = 'S'
    which_spin_channel      =  0
    chi_kernel              = 'CHI'
    l_use_localise_repr     = .false.
    l_use_bisection_thr     = .false.
    qbox_bisec_wfc_filename = 'qb.gs.xml'
/
&QBOX_CONTROL
    xml_file = 'qb.gs.xml'
    xc = 'PBE'
    amplitude = 0.0
    wf_dyn = 'PSDA'
    nitscf = 20
    nite = 0
    io = 'base64_parallel'
/  
&WBSE_CONTROL
    !
    wbse_calculation         = 'S'
    l_qp_correction          = .false.
    wbse_diag_method         = 'david'
    !
    l_diag_term_only         = .false.
    l_bse_calculation        = .false.
    !
    l_hybrid_calculation     = .false.
    l_exx_fraction           = 0.18
    l_h_loc                  = .false.
    l_h_bis                  = .false.
    l_h_ovlp_thr             = 0.0
    l_h_qbox_bis_wfc_fname   = 'qb.gs.xml'
    !
    l_subspace               = .false.
    n_trunc_bands            = 0
    !
    n_plep_eigen             =  4
    n_plep_times             =  12
    n_plep_maxiter           =  10000
    !
    n_plep_read_from_file    =  4
    l_preconditioning        = .false.
    !
    trev_plep                =  1.D-6
    trev_plep_rel            =  1.D-8
    !
    l_tddft_force            = .true.
    force_state              = 4
    wbse_zv_scf_tr2          = 1.D-12
    !
    spin_excitation          = 'flipped'    
    l_sf_kernel              = .true.
    sf_cut_1                 = 1.D+3
    sf_cut_2                 = 1.D-4
    !
    l_alda0                  = .false.
    !
/
